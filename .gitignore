*.db
*.sqlite3
backend/temp/
backend/uploads/

# ---- Python ----
__pycache__/
*.py[cod]
venv/
env/
.venv/
.ipynb_checkpoints/

# ---- Node ----
node_modules/
dist/
.vite/

# ---- Datasets (fetch from source, see README) ----
data/
datasets/
*.zip

# ---- OS ----
Thumbs.db
desktop.ini
.DS_Store

# Coursework reports, presentations, certificates and client deliverables.
# Kept out deliberately: academic-integrity, third-party and client-
# confidentiality reasons. Result figures are committed; documents are not.
*.pdf
*.docx
*.doc
*.pptx
*.ppt
!docs/figures/*
