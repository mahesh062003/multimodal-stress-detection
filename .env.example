# Copy to .env and fill in. Never commit .env.

# Google Fit OAuth - create your own credentials in Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, type "Desktop app"),
# download the JSON and point this at it.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Where the OAuth refresh token is cached after the first consent flow.
GOOGLE_TOKEN_PATH=./token.pickle

# SQLite database for sessions, health records and stress results.
DATABASE_PATH=./stress.db

FLASK_PORT=5000
